# Copy to .env.local and fill in. NEVER commit .env.local - it is gitignored.
# Supabase project -> Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key. Safe in the browser: every table has row-level security,
# so this key can only ever read rows the signed-in user owns.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# The deployed origin, used to build the OAuth redirect URL

# GitHub personal access token, read only. Powers the Code card.
GITHUB_TOKEN=

# Anthropic API key. Powers the briefing and the chat.
ANTHROPIC_API_KEY=
