# Copy to .env.local and fill in. NEVER commit .env.local - it is gitignored.
# Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Used only by server code that must bypass row-level security. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# The deployed origin, used to build the OAuth redirect URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
